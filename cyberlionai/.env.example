# Cyber Lion AI — ortam değişkenleri (ÖRNEK).
#
# Bu dosya değerleri DEĞİL, isimleri belgeler. Gerçek değerler Vercel'de
# tanımlanır (Project Settings > Environment Variables) ve .gitignore
# `.env`/`.env.local`'ı zaten dışarıda tutuyor.
#
# Değerleri loga, DB'ye ve PR açıklamasına YAZMAYIN.

# ---- Kalıcı sayaç deposu (Upstash Redis REST) ----
# Hız sınırı ve ücretsiz tarama kotası burada tutulur. Yoksa /api/scan ve
# /api/verify-dns 503 döner (bilinçli kapalı devre).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Telegram bildirimleri (bkz. docs/telegram.md) ----
# Üçü de yoksa bildirim katmanı sessizce kapalı kalır; hiçbir uç bozulmaz.
# TELEGRAM_BOT_TOKEN biçimi "<sayı>:<~35 karakter>"; 20 karakterden kısası
# yapılandırma hatası sayılıp reddedilir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opsiyonel: kritik uyarılar (500/502/504, tarama düşmesi, DNS zaman aşımı)
# ayrı bir sohbete gider. Tanımsızsa TELEGRAM_CHAT_ID kullanılır.
TELEGRAM_ALERT_CHAT_ID=

# ---- Asenkron tarama kuyruğu (bkz. docs/scan-queue.md) ----
# 'true' DEĞİLSE kuyruk kapalı ve /api/scan eşzamanlı çalışır (varsayılan).
SCAN_QUEUE_ENABLED=
ENQUEUE_SHARED_SECRET=
# S3 raporunun imzalı indirilmesi (Edge Function `sign-report`).
SIGN_SHARED_SECRET=

# ---- Haftalık tarama cron'u (QStash) ----
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---- Ödeme (iyzico Subscription v2) ----
# Gerçek anahtarlar gelene kadar /api/checkout 503 checkout_unconfigured döner.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=

# ---- Cloudflare 1-tık düzeltme (kullanıcının kendi token'ı) ----
# Token İSTEMCİDEN gelir, burada DURMAZ ve loglanmaz.

# ---- AI analist (NVIDIA Nemotron, bkz. docs/ai-analyst.md) ----
# Anahtar yoksa katman kapalı: /api/ai-report 503 ai_unconfigured döner,
# tarama ve diğer uçlar etkilenmez. Anahtar YALNIZCA Authorization
# başlığında kullanılır, hiçbir loga ve hiçbir yanıta girmez.
NVIDIA_API_KEY=
# Opsiyonel: model adı değişirse tek satırlık değişiklik.
# Varsayılan: nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL=
# Opsiyonel: uyumlu başka bir OpenAI-biçimli uç.
# Varsayılan: https://integrate.api.nvidia.com
NVIDIA_BASE_URL=
