{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/scan.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/verify-dns.js": {
      "maxDuration": 15,
      "memory": 256
    },
    "api/worldmap.js": {
      "maxDuration": 20,
      "memory": 512
    },
    "api/cron/weekly-scan.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/cron/tick.js": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/report.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; script-src 'self' 'sha256-TBN8Q6psxPFqMOdGUWIBFIa9Btk+pnLR0R+6W1rTuNo=' 'sha256-XFpZWZkFF6aM74UA6wSrgvarZKAi01ihFiXGFgX8j+8=' 'sha256-5jKpabAFPREw4Q2O7Q61mEpZ/Thy9axSNpJZ5AhTFAo=' 'sha256-BstmcbLtkVLwSTYcEJJi5vYnI+4m1xL6YwKWErA2xS4=' 'sha256-2a3asYwzJ5pElwEg0p/9jx/8jFLILtxKG37x7W6w4lU=' 'sha256-kuOJ/6m4CZpwgb/TTGzq5FEf0vxQV6CY3o+pf/d9lKo=' 'sha256-hQ/oZlh8iMhZvWVtxhccpYPNyZ1he1s5zS+RFtKfI14=' 'sha256-bbJNHos/F0a9fz/jIB0MkIfkH2Hg+IwDY9rjjO4Twls=' 'sha256-xUoNGpJxoJZSBIgot43cUrYNf+NN+Z4gbxGTjdcff30=' 'sha256-nUp3KjL7iS2hq0OLHkMrRSZd3Gbn9SgiwnQJ69qyBlE=' 'sha256-TZL7o6yIbDbbRtZPLNZSjj423GhopJrTDWfKk2F9r+w=' 'sha256-hlQC1w/Y1pvTM85N4MglOtvX6acRYRgSJrsU4jLh4x4=' 'sha256-kKQjffethgWQEkt+syPxj8ZsF92rKx3S1gGE86riSvI=' 'sha256-3r+JarKUDjIQCNRex5upJytL3yv6bLqgtLEVtOFgpSk=' 'sha256-Wg60lGscb2izJm7hsOBwGjLWMGqPqbixWmsDSzub2AI=' 'sha256-4UdRyW+L305MbGfb/pZBhSNWvqU81ihNrV6cP8jOXoQ=' 'sha256-gWnRNFSw++ep/i28ydIjPHZU9j3HBojqBruW6p2GHeI=' 'sha256-jq+OoRVY/VnTG5STRotMQQZR36vL9pa6NdkyiB2cFz0=' 'sha256-1+ff7XWjSJpnuL5BjQnlg91ZsI9LbnHCemLPHgfuEf8=' 'sha256-PAY08nkJQm53+KR0GfLaPRrf1Y2QT9TnbPeMQLccAFA=' 'sha256-o+of3JxRCNuITO22+k6jz4FFFJfPmDceWQCVnzU/lfE=' 'sha256-o3fXLRjysbcdiKWo58HwQjXARPGjXrIHkrCVe3NAz60='; connect-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    },
    {
      "source": "/((?!badge/).*).(png|jpg|jpeg|svg|webp|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/badge/:domain.svg",
      "destination": "/api/badge?domain=:domain"
    }
  ],
  "redirects": [
    {
      "source": "/panel",
      "destination": "/dashboard",
