    },
    {
      "source": "/pages/kvkk-aydinlatma-metni",
      "destination": "/kvkk-aydinlatma-metni",
      "permanent": false
    },
    {
      "source": "/pages/kullanim-sartlari",
      "destination": "/kullanim-kosullari",
      "permanent": false
    },
    {
      "source": "/pages/teslimat-ve-iade-sartlari",
      "destination": "/iade-iptal-politikasi",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-scan",
      "schedule": "0 6 * * *"
    }
  ]
}
