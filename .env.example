# Stripe billing (Phase 2: $199 Starter / $999 Pro / $2499 Enterprise)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Scraper — SAM.gov Opportunities API (api.sam.gov). Optional: without a key
# the scraper falls back to a simulated feed so the app still works end-to-end.
SAM_API_KEY=

# Cron auth — shared secret required by Vercel Cron / external schedulers
# when set. If unset, /api/cron/daily runs without auth (demo mode).
CRON_SECRET=

# Public base URL used for Stripe checkout success/cancel redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
