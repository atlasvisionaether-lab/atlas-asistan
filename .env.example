# Micro-SaaS Factory environment
# Public base URL of this factory deployment (used by the dashboard and docs).
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase (used by generated products; not required by the factory itself)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Factory options
FACTORY_PRODUCTS_DIR=products
FACTORY_TEMPLATE_DIR=templates/micro-saas-template
