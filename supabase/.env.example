# Atlas Asistan — Edge Function ortam değişkenleri (örnek).
# Gerçek anahtarlar ASLA bu dosyaya yazılmaz; Supabase secrets'ta tutulur:
#   supabase secrets set LOVABLE_API_KEY=...
#   supabase secrets set OPENAI_API_KEY=...
# Dashboard: Project Settings > Edge Functions > Secrets

# AI sağlayıcısı — Lovable AI Gateway (birincil).
# Edge Function bu anahtar varsa chat completion'ı Lovable Gateway üzerinden yapar.
LOVABLE_API_KEY=

# AI sağlayıcısı — OpenAI (fallback; LOVABLE_API_KEY yoksa kullanılır).
OPENAI_API_KEY=

# Supabase runtime tarafından otomatik sağlanır (elle set edilmez):
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_ANON_KEY
