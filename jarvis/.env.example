# Ollama
JARVIS_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# Asistan kimligi
JARVIS_NAME=Atlas
# Surekli dinlemede sizi duyunca uyanacagi sozcukler (virgulle ayirin)
JARVIS_WAKE_WORDS=atlas,atlas asistan

# Ses tanima (faster-whisper model boyutu: tiny | base | small | medium)
WHISPER_MODEL=small
WHISPER_LANG=tr

# Mikrofon: sessizlik esigi (0.005-0.05 arasi denenebilir) ve
# konusma bittikten sonra beklenecek sure (saniye)
MIC_SILENCE_THRESHOLD=0.012
MIC_SILENCE_SECONDS=1.2
MIC_MAX_SECONDS=20

# TTS: piper ses dosyasi (bos birakilirsa espeak-ng kullanilir)
PIPER_VOICE=voices/tr_TR-dfki-medium.onnx

# Ses tanima cihazi: cpu (varsayilan, her zaman calisir) | cuda (CUDA kuruluysa daha hizli)
WHISPER_DEVICE=cpu

# Ortam gurultusunun kac kati ses "konusma" sayilsin (2.0 = hassas, 5.0 = sadece yuksek ses)
MIC_NOISE_FACTOR=3.0

# Internet aramasi: 1 acik (model gerekli gordugunde arar), 0 kapali
JARVIS_WEB=1
JARVIS_WEB_RESULTS=5
JARVIS_WEB_REGION=tr-tr

# Model cevaptan once kendi kendine akil yursun mu? (qwen3 gibi modellerde)
# 0 kapali (hizli, sesli asistan icin onerilen), 1 acik (daha isabetli, cok daha yavas)
JARVIS_THINK=0
