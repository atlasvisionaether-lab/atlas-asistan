# docker-compose.yml için. Gerçek değerlerle doldurup `.env.docker` olarak
# kaydedin. `.env.docker` .gitignore'da; buraya SIR YAZMAYIN.

# n8n paneli için temel kimlik doğrulama (zorunlu).
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# CyberLion API'nin kökü. Yerelde `vercel dev` için http://host.docker.internal:3000
N8N_API_BASE=https://www.cyberlionai.com

# n8n'in dışa açık adresi. Tünel kullanıyorsanız tünel adresi.
N8N_WEBHOOK_BASE=http://localhost:5678

# Vercel'deki CRON_SECRET ile AYNI değer olmalı.
CL_CRON_SECRET=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# WORKFLOW 4 (push). Boş bırakılırsa o akış FCM düğümünde durur.
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
